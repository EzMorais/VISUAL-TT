# ============================================================
# PERSONAL OS — CONFIGURAÇÕES
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Servidor
PORT=3001
FRONTEND_URL=http://localhost:5173
TIMEZONE=America/Sao_Paulo

# Claude AI (obrigatório para IA)
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Calendar (opcional — para sincronizar agenda)
# Obtenha em: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# WhatsApp
# WHATSAPP_PHONE: número do seu celular (ex: 5511999999999)
# O bot vai responder mensagens enviadas para ele mesmo (para você mesmo)
WHATSAPP_PHONE=5511999999999

# Horário do briefing matinal (hora local, padrão: 7)
BRIEFING_HOUR=7

# Caminho do banco de dados
DB_PATH=./data/personal-os.db

# Opcional — só preencha se quiser ver um custo estimado (R$) na aba "Uso".
# Confira o preço atual em https://console.anthropic.com antes de preencher
# — isso é só uma estimativa local, não reflete sua fatura real.
# CLAUDE_INPUT_PRICE_PER_1M=15
# CLAUDE_OUTPUT_PRICE_PER_1M=75
